cwlVersion: v1.2
class: CommandLineTool
label: "Convert Short with score format to .hic format using Juicer Tools"
id: "juicertools-pre"
#baseCommand: ["java", "-jar", "/juicer/Juicer_toolsjar", "pre"]
baseCommand: ["java", "-jar", "juicer/Juicer_toolsjar", "pre"]

requirements:
  InlineJavascriptRequirement: {}
  DockerRequirement:
    dockerImageId: cwl-ld-tsv2pear:3.9
    dockerFile: |
      # Dockerfile
      FROM openjdk:17-jre-slim
      WORKDIR /juicer
      # Juicer Tools の Jar ファイルをダウンロード
      ADD https://s3.amazonaws.com/hicfiles.tc4ga.com/public/juicer/juicer_tools_1.22.01.jar /juicer/juicer_tools.jar
      CMD ["java", "-jar", "/juicer/juicer_tools"]
      USER root
  ResourceRequirement:
    ramMin: 30000
    coresMin: 24 

hints:
  MemoryRequirement:
    value: 16000

inputs:
  input_short_with_score:
    type: File
    inputBinding:
      position: 1
    doc: "Input file in 'Short with score' format."

  output_hic_name:
    type: string
    inputBinding:
      position: 2
    doc: "Name for the output .hic file."

  genome_id:
    type: string
    inputBinding:
      position: 3
    doc: "Genome identifier, e.g., hg19, mm10."

outputs:
  hic_file:
    type: File
    outputBinding:
      glob: "$(inputs.output_hic_name)"
    doc: "The generated .hic file from the input data."

stdout: output.log
stderr: error.log

